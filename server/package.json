{
  "name": "vista-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/local.ts",
    "start": "tsx --env-file=../.env src/local.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "roles": "tsx --env-file=../.env src/scripts/assignRoles.ts",
    "vercel-build": "npm --prefix ../client install && npm --prefix ../client run build -- --outDir ../server/public --emptyOutDir"
  },
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
