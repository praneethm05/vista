# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/vista
# Clerk (dashboard → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Client reads this one (Vite exposes only VITE_* vars)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Email (Resend). Leave RESEND_API_KEY empty to disable email.
RESEND_API_KEY=
EMAIL_FROM=Vista <vista@yourdomain.com>
APP_URL=http://localhost:5173
